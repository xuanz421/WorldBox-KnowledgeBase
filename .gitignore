# Generated / local data
data/raw/*
data/generated/*
data/cache/*

# Keep directory structure
!data/raw/.gitkeep
!data/generated/.gitkeep
!data/cache/.gitkeep

# Machine-specific local config (absolute paths)
config/wbkb.local.json

# Assemblies / binaries
*.dll
*.exe
*.pdb

# Decompiled bulk sources if later placed locally
data/**/decompiled/

