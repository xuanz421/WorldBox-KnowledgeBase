*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Archives
*.zip
*.7z
*.rar

# IDE
.vs/
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Build/cache
bin/
obj/
__pycache__/
*.pyc
